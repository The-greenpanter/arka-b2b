              ]
            },
            "description": "Verifica que el gateway esté UP"
          },
          "response": []
        },
        {
          "name": "ms-catalog health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/actuator/health",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
