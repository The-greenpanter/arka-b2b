    {
      "name": "🏭 ms-provider — Proveedores",
      "item": [
        {
          "name": "Crear proveedor",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/providers",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "providers"
              ]
            },
            "description": "Registra un proveedor. Retorna 201 con providerId UUID.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"TechCorp Colombia\",\n  \"contactEmail\": \"ventas@techcorp.co\",\n  \"phone\": \"+573001234567\",\n  \"leadTimeDays\": 5,\n  \"active\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Listar proveedores",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/providers",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "providers"
              ]
            },
            "description": "Retorna lista de todos los proveedores registrados."
          },
          "response": []
        },
        {
          "name": "Obtener proveedor por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/providers/{providerId}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "providers",
                "{providerId}"
              ]
            },
            "description": "Reemplaza {{providerId}} con el UUID retornado en la creación."
          },
          "response": []
        }
      ]
    },
    {
      "name": "📦 ms-catalog — Productos (HU1)",
      "item": [
        {
          "name": "HU1 — Crear producto (inicia saga)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "Crea producto en estado PENDING. Dispara saga: Kafka → ms-inventory crea stock → ms-provider valida proveedor → producto queda ACTIVE.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Laptop ThinkPad X1\",\n  \"description\": \"Laptop empresarial 14 pulgadas, Intel i7, 16GB RAM\",\n  \"category\": \"ELECTRONICS\",\n  \"basePriceUsd\": 1200.0,\n  \"taxRate\": 0.19,\n  \"minOrderQty\": 1,\n  \"maxOrderQty\": 50,\n  \"supplier\": {\n    \"supplierId\": \"{{providerId}}\",\n    \"name\": \"TechCorp Colombia\",\n    \"leadTimeDays\": 5\n  },\n  \"attributes\": {\n    \"brand\": \"Lenovo\",\n    \"color\": \"Negro\",\n    \"weight_kg\": 1.4\n  }\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Listar todos los productos",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "products"
              ]
            },
            "description": "Lista productos. Filtros opcionales: ?status=ACTIVE ?category=ELECTRONICS"
          },
          "response": []
        },
        {
          "name": "Listar productos ACTIVE",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products?status=ACTIVE",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "products?status=ACTIVE"
              ]
            },
            "description": "Solo productos activos (saga completada exitosamente)."
          },
          "response": []
        },
        {
          "name": "Obtener producto por ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products/{productId}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{productId}"
              ]
            },
            "description": "Reemplaza {{productId}} con el UUID del producto creado."
          },
          "response": []
        },
        {
          "name": "Confirmar producto manualmente",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/v1/products/{productId}/confirm",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "v1",
                "products",
                "{productId}",
                "confirm"
              ]
            },
            "description": "Atajo para confirmar un producto PENDING sin esperar la saga completa. Útil para demo."
          },
          "response": []
        }
      ]
    },
    {
      "name": "📊 ms-inventory — Stock (HU2, HU3)",
      "item": [
        {
          "name": "Crear stock manualmente",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/stocks",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "stocks"
              ]
            },
            "description": "Normalmente lo crea la saga (HU1). Úsalo si necesitas crear stock manualmente para demo.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"providerId\": \"{{providerId}}\",\n  \"minimumThreshold\": 5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Ver stock de producto",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/stocks/{productId}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "stocks",
                "{productId}"
              ]
            },
            "description": "Muestra availableQty, reservedQty, minimumThreshold y alertSent."
          },
          "response": []
        },
        {
          "name": "HU2 — Reabastecer stock (restock)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/stocks/{productId}/restock",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "stocks",
                "{productId}",
                "restock"
              ]
            },
            "description": "Agrega 100 unidades al stock disponible. Puede desactivar alerta si estaba activa.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 100\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Reservar stock",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/stocks/{productId}/reserve",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "stocks",
                "{productId}",
                "reserve"
              ]
            },
            "description": "Reserva 2 unidades (parte del flujo de checkout). Retorna 409 si no hay suficiente stock.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "🛒 ms-cart — Carrito (HU4, HU8)",
      "item": [
        {
          "name": "HU8 — Agregar ítem al carrito",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{BASE_URL}}/api/carts/cliente-001/items",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "carts",
                "cliente-001",
                "items"
              ]
            },
            "description": "Crea carrito si no existe para cliente-001 y agrega el ítem. El carrito se identifica por customerId.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"productName\": \"Laptop ThinkPad X1\",\n  \"quantity\": 2,\n  \"unitPrice\": 1200.0\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Obtener carrito",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/carts/{cartId}",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "carts",
                "{cartId}"
              ]
            },
            "description": "Reemplaza {{cartId}} con el ID retornado en addItem. Muestra ítems y total."
          },
          "response": []
        },
        {
          "name": "HU4 — Checkout (inicia saga de pedido)",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{BASE_URL}}/api/carts/{cartId}/checkout",
              "host": [
                "{{BASE_URL}}"
              ],
              "path": [
                "api",
                "carts",
                "{cartId}",
                "checkout"
              ]
            },
            "description": "Convierte el carrito en orden. Dispara saga: Kafka → ms-inventory reserva stock → ms-order crea orden → ms-payment procesa pago → ms-notifications notifica."
          },
          "response": []
        }
      ]
    },
